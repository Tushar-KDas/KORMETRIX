# ==============================================================================
# WORKFORCE 360 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="WorkForce 360"
NEXT_PUBLIC_APP_TAGLINE="One Platform. Complete Workforce Control."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Dhaka"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL="৳"

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND (DATABASE, AUTH, STORAGE, REALTIME)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder-server-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# 3. REMOTE CONFIGURATION & APP CONTROLS
# ------------------------------------------------------------------------------
REMOTE_CONFIG_CACHE_TTL_SECONDS=300
REMOTE_CONFIG_SIGNING_KEY=your-remote-config-signing-key

# ------------------------------------------------------------------------------
# 4. PUSH NOTIFICATIONS (FIREBASE CLOUD MESSAGING)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=workforce360-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@workforce360-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. BANGLADESH SMS GATEWAYS (SSL Wireless / Greenweb / Twilio)
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=greenweb # Options: greenweb, sslwireless, twilio, mock
SMS_GATEWAY_API_TOKEN=your-sms-api-token
SMS_GATEWAY_SENDER_ID=WORKFORCE360

# ------------------------------------------------------------------------------
# 6. BANGLADESH PAYMENT GATEWAYS (bKash / Nagad / SSLCommerz / Stripe)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=sslcommerz # Options: sslcommerz, bkash, nagad, stripe, manual
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWD=your-store-password
SSLCOMMERZ_IS_SANDBOX=true

BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# 7. EMAIL (SMTP / Resend / SendGrid)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend # Options: resend, smtp, mock
RESEND_API_KEY=re_your_api_key_placeholder
EMAIL_FROM="WorkForce 360 <notifications@workforce360.com>"

# ------------------------------------------------------------------------------
# 8. AUDIT & SECURITY
# ------------------------------------------------------------------------------
SECURITY_ENCRYPTION_KEY=32-character-secret-key-placeholder!!
AUDIT_LOG_RETENTION_DAYS=365

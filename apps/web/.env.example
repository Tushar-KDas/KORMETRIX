# ==============================================================================
# WORKFORCE 360 - SUPABASE CONFIGURATION
# ==============================================================================

# Replace with your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Replace with your Supabase Project Anon API Key (starts with eyJhbGciOi...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Key for administrative backend scripts (Keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
